{
  "name": "mesa-verde-banking",
  "private": true,
  "type": "module",
  "imports": {
    "#tools/*": "./tools/*.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "demo:setup": "tsx --env-file-if-exists=.env scripts/setup.ts",
    "test": "vitest run",
    "lint": "pnpm run lint:oxlint && pnpm run lint:format && pnpm run lint:types",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:format": "oxfmt --check .",
    "lint:types": "next typegen && tsc -p tsconfig.json",
    "fix": "oxlint --fix . && oxfmt --write ."
  },
  "dependencies": {
    "@ant-design/nextjs-registry": "1.3.0",
    "@permitio/permit-js": "0.6.0",
    "antd": "6.6.8",
    "better-auth": "1.7.15",
    "next": "16.4.4",
    "permit-fe-sdk": "1.7.2",
    "permitio": "2.7.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.9.1"
}
