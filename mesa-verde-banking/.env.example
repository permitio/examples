# Copy this file to .env. Only PERMIT_API_KEY is required.

# An environment-level API key: in Permit, Settings > API Keys. Use a fresh environment: setup
# applies main.tf to it and adds the demo data.
PERMIT_API_KEY=

# The Permit API. For a local Permit backend from inside Docker:
# PERMIT_API_URL=http://host.docker.internal:8000
PERMIT_API_URL=https://api.permit.io

# Host ports of the app and the PDP.
APP_PORT=3000
PDP_PORT=7766

# Optional: the approval webhook. Set PUBLIC_URL to a URL Permit can reach the app at (for
# example an ngrok tunnel to APP_PORT) and WEBHOOK_SECRET to a long random value
# (`openssl rand -hex 32`); setup then registers <PUBLIC_URL>/account/webhook. Without them,
# wire transfer approvals still work in the Elements, but the app is not told about them.
PUBLIC_URL=
WEBHOOK_SECRET=

# Optional: where the browser loads Permit Elements from. The defaults are Permit's cloud. For a
# local Permit, PERMIT_ELEMENTS_API_URL is the API URL as the browser reaches it (for example
# http://localhost:8000, when PERMIT_API_URL is http://host.docker.internal:8000), and
# PERMIT_ELEMENTS_URL is where that deployment serves the Elements.
PERMIT_ELEMENTS_URL=https://embed.permit.io
PERMIT_ELEMENTS_API_URL=

# Optional: a fixed Better Auth secret. Without it, setup generates one in the data volume.
# BETTER_AUTH_SECRET=
