# Copy to .env (gitignored) and fill in the key.
# An environment-scoped API key from the Permit dashboard. The setup, the app and the PDP use it, and
# only this one: a different PERMIT_API_KEY exported in your shell stops the commands.
PERMIT_API_KEY=
PERMIT_API_URL=https://api.permit.io
# Optional: the project and environment keys. `make setup` and `make reset` stop when the API key
# belongs to another environment; the app shows them on its start line.
PERMIT_PROJECT=
PERMIT_ENV=
PDP_URL=http://localhost:7766
OPA_URL=http://localhost:8181
PORT=3000
