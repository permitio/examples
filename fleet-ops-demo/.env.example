# Copy to .env (gitignored) and fill in the key.
# An environment-scoped API key from the Permit dashboard. The setup, the app and the PDP use it.
PERMIT_API_KEY=
PERMIT_API_URL=https://api.permit.io
# Shown on the app's start line only.
PERMIT_PROJECT=
PERMIT_ENV=
PDP_URL=http://localhost:7766
OPA_URL=http://localhost:8181
PORT=3000
