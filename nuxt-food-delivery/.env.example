# Copy to .env and fill in PERMIT_API_KEY. Docker Compose and `pnpm dev` both read .env.

# The API key of the Permit environment to use (Permit dashboard: Settings > API Keys).
# `docker compose up` writes this example's policy and demo users to it, so use an environment made
# for the example.
PERMIT_API_KEY=

# Permit's API. For a Permit backend running on this machine, use http://host.docker.internal:8000
# with Docker Compose, or http://localhost:8000 with `pnpm dev`.
PERMIT_API_URL=https://api.permit.io

# Host ports for the app and the PDP.
APP_PORT=3000
PDP_PORT=7766

# The PDP returns the reason for each decision in its log when this is on.
PDP_DEBUG=True

# `pnpm dev` only: where the app finds the PDP. Docker Compose points the app at its own PDP.
PERMIT_PDP_URL=http://localhost:7766
