{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "jsdoc": {
    "addDefaultToDescription": false,
    "capitalizeDescriptions": false,
    "lineWrappingStyle": "greedy"
  },
  "ignorePatterns": [".next/**", ".data/**", "node_modules/**", "pnpm-lock.yaml", "next-env.d.ts"]
}
