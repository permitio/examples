# Copy to .env and fill in PERMIT_API_KEY. Docker Compose and `pnpm run setup` read .env; so does
# `pnpm dev` (Next.js loads it).

# The API key of the Permit environment this example writes its policy and demo data to
# (Permit dashboard: Settings > API Keys). Use an environment made for this example.
PERMIT_API_KEY=

# Permit's API. The local PDP uses it as its control plane. For a Permit backend running on your
# machine, use http://host.docker.internal:8000 with Compose.
PERMIT_API_URL=https://api.permit.io

# Host ports for the app and the PDP.
APP_PORT=3000
PDP_PORT=7766
