{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "trailingComma": "all",
  "semi": true,
  "jsdoc": {
    "addDefaultToDescription": false,
    "capitalizeDescriptions": false,
    "lineWrappingStyle": "greedy"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", "vendor/**", "pnpm-lock.yaml"]
}
