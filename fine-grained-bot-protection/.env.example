# Copy this file to .env and fill in PERMIT_API_KEY. Docker Compose and `pnpm dev` both read .env.

# An environment API key from Permit (Settings > API Keys). Setup writes the example's policy to that
# environment, so use one made for this example.
PERMIT_API_KEY=
# Permit's API. For a local Permit backend: http://host.docker.internal:8000
PERMIT_API_URL=https://api.permit.io

# Optional: an Arcjet key (https://app.arcjet.com). Without one, the app classifies callers by their
# User-Agent only.
ARCJET_KEY=
# Arcjet's mode. development accepts the private addresses that Docker and localhost requests have.
ARCJET_ENV=development

# Host ports for Compose.
APP_PORT=3000
PDP_PORT=7766

# Dev mode only (`pnpm dev`): where the app finds the PDP.
PERMIT_PDP_URL=http://localhost:7766
