{
  "name": "fine-grained-bot-protection",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*.ts",
    "#test/*": "./test/*.ts",
    "#tools/*": "./tools/*.ts"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "setup-policy": "node --env-file-if-exists=.env src/setup.ts",
    "test": "vitest run",
    "lint": "pnpm run lint:oxlint && pnpm run lint:format && pnpm run lint:types",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:format": "oxfmt --check .",
    "lint:types": "tsc -p tsconfig.json",
    "fix": "oxlint --fix . && oxfmt --write ."
  },
  "dependencies": {
    "@arcjet/node": "1.15.0",
    "express": "5.3.0",
    "permitio": "2.7.7"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.91.0",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "supertest": "7.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.17.0"
}
