# Copy to .env and set PERMIT_API_KEY. Docker Compose, pnpm seed, pnpm check:policy and pnpm dev
# all read .env.

# The API key of the Permit environment this example writes its policy to. Use an environment made
# for this example: setup puts the demo users' roles and attributes back to their starting state.
PERMIT_API_KEY=

# Permit's REST API, also the PDP's control plane. Keep the default for Permit cloud; for a Permit
# backend running on this machine, use http://host.docker.internal:8000 with Compose.
PERMIT_API_URL=https://api.permit.io

# The PDP the app asks in dev mode. Compose sets its own for its services.
PERMIT_PDP_URL=http://localhost:7766

# Host ports for Compose.
APP_PORT=3000
PDP_PORT=7766

# PDP debug mode: the PDP logs the reason for each decision.
PDP_DEBUG=True

# The Permit SDK's own logging, silent by default (the app and the scripts report errors).
# PERMIT_LOG_LEVEL=warn
