{
  "name": "permit-portal-demo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "test": "vitest run",
    "lint": "pnpm run lint:oxlint && pnpm run lint:types",
    "lint:oxlint": "oxlint --deny-warnings .",
    "lint:types": "tsc -p apps/portal/tsconfig.json && tsc -p apps/great-eagle-systems/tsconfig.json",
    "fix": "oxlint --fix .",
    "build:web": "pnpm --filter @permit-demo/portal run build"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/supertest": "6.0.3",
    "oxlint": "1.87.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
