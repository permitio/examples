{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "import",
    "unicorn",
    "react"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "vendor/**"
  ],
  "env": {
    "builtin": true,
    "node": true,
    "browser": true
  },
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "./**",
              "../**"
            ],
            "message": "Use #src/, #scripts/, #test/ or, in the web app, @/ imports."
          }
        ]
      }
    ]
  }
}
