# Optional settings for the demo stack, shown with their defaults. None of them is a secret.
# The Permit API URL and key do not go here: they live in profiles/<name>.env (see profiles/README.md).
#
# `bin/demo up` hands the profile file to Compose with --env-file, so Compose does not read a .env file.
# To change a setting, set it in the shell for that run, for example:
#   PDP_DEBUG=False bin/demo up demo

# PDP: debug mode. When it is on, the PDP returns Permit's reason with each decision, and the portal's
# decision panel shows it. Keep it on: the default write mode below needs it.
PDP_DEBUG=True

# Portal: let the presenter move the clock forward. The portal adds the offset to the current_time it sends with each check.
DEMO_CLOCK_ENABLED=false

# Portal: length of the "2 minutes (demo)" collaborator grant, in milliseconds.
GRANT_DEMO_DURATION_MS=120000

# Great Eagle systems mock: how often the cleanup job removes expired grant entries, in milliseconds. Each reset restarts
# the countdown. 60 minutes keeps it from removing an expired grant in the middle of S4; "Run cleanup now" shows it.
CLEANUP_INTERVAL_MS=3600000

# Portal: how writes reach Permit. fast (default): straight to Permit's API, then confirmed by reading the change back
# from the local PDP (needs PDP_DEBUG on). waited: through the PDP, which answers once it has applied the change.
PERMIT_WRITES=fast
